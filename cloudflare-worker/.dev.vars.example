# Secrets for this Worker. The "Deploy to Cloudflare" page asks for each of
# these, prefilled with REPLACE_ME: replace every one. The Worker refuses to
# run with a placeholder. For `wrangler dev`, copy this file to .dev.vars.
SV_CLIENT_ID=REPLACE_ME # the log agent's client id (sva_...), from StreamVessel
SV_CLIENT_SECRET=REPLACE_ME # the log agent's secret (svas_...), shown once when you create it
BULK_PASSWORD=REPLACE_ME # a new password App Platform will send; at least 16 characters, e.g. `openssl rand -base64 32`
